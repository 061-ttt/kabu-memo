// E2Eテスト専用。Workers AI と外部株価APIは模擬、Google OAuth は tests/e2e/mock-google.ts に向ける
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kabu-memo-e2e",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "kabu-memo-e2e", "database_id": "e2e-local", "migrations_dir": "migrations" }],
  "vars": {
    "AI_MODE": "mock",
    "MARKET_MODE": "mock",
    "AI_DAILY_LIMIT": "5",
    "GOOGLE_CLIENT_ID": "e2e-client",
    "GOOGLE_CLIENT_SECRET": "e2e-secret",
    "SESSION_SECRET": "e2e-session-secret-not-for-production",
    "GOOGLE_AUTH_URL": "http://127.0.0.1:8790/authorize",
    "GOOGLE_TOKEN_URL": "http://127.0.0.1:8790/token",
    "GOOGLE_USERINFO_URL": "http://127.0.0.1:8790/userinfo"
  }
}
